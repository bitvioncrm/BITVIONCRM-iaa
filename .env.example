# Browser. These two are safe to expose. They are not secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# WhatsApp Automation console (WAHA bulk / scan-connect). Local default:
VITE_WHATSAPP_AUTOMATION_URL=http://127.0.0.1:5178

